// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/typescript-node
{
  "name": "Node.js & TypeScript",
  "build": {
    "dockerfile": "Dockerfile"
  },
  // Features to add to the dev container. More info: https://containers.dev/features.
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers-extra/features/tmux-apt-get:1": {},
    "ghcr.io/postfinance/devcontainer-features/playwright-deps:1.0.0": {
      "installChromiumDeps": true
    }
  },
  "runArgs": ["--cap-drop=ALL"],
  // Store Claude Code auth/config in a unique persistent volume
  "mounts": [
    "source=${localWorkspaceFolderBasename}-claude-code-auth,target=/home/node/.claude,type=volume"
  ],
  "containerEnv": {
    // If unset, tmux (and other shell-spawning tools) fall back to a dumb /bin/sh
    "SHELL": "/bin/bash",
    // If a user lands in /bin/sh somehow, warn them. dash uses $ENV for init scripts
    "ENV": "/etc/dash-warning.sh"
  },
  // Forward 5173 to access Vite from the container's host
  "forwardPorts": [5173],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  // PLAYWRIGHT_BROWSERS_PATH avoids re-downloading Playwright and its dependencies on every rebuild
  // MINIFLARE_CHROME_EXECUTABLE points Miniflare to a compatible Chromium build (arm64, not x86)
  "remoteEnv": {
    "PLAYWRIGHT_BROWSERS_PATH": "/workspaces/.ms-playwright-cache",
    "MINIFLARE_CHROME_EXECUTABLE": "/workspaces/.ms-playwright-cache/chromium-1208/chrome-linux/chrome"
  },
  "customizations": {
    "vscode": {
      "extensions": ["bierner.markdown-mermaid", "esbenp.prettier-vscode"],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode"
      }
    }
  },
  // Login as "node" so that:
  // - We keep file-ownership the same as when the files were created
  // - We pick up the fancy prompt the base image already defines for non-root users
  "containerUser": "node"
  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  // "remoteUser": "root"
}
